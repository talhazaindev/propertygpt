{
  "expo": {
    "name": "Manzil",
    "slug": "manzil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "manzil",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "pk.alwahabco.manzil"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#195b3b",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "pk.alwahabco.manzil",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#faf8f3"
        }
      ],
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://propertygpt-six.vercel.app",
      "serverOrigin": "https://propertygpt-six.vercel.app",
      "sentryDsn": "",
      "privacyUrl": "",
      "termsUrl": "",
      "eas": {
        "projectId": ""
      }
    }
  }
}
