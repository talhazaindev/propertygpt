# MongoDB Atlas (required) — never localhost.
# Prefer mongodb+srv:// when your DNS resolves SRV correctly.
# If you hit querySrv EBADRESP, use the standard mongodb:// shard host URI from Atlas
# (Connect → Drivers → older driver / standard connection string).
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/propertygpt?retryWrites=true&w=majority&appName=Cluster0"

# NextAuth
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_URL="https://your-production-domain.com"

# UploadThing (optional until uploads are configured)
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""
