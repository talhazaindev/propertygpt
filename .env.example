# MongoDB Atlas (required) — never localhost.
# Prefer mongodb+srv:// when your DNS resolves SRV correctly.
# If you hit querySrv EBADRESP, use the standard mongodb:// shard host URI from Atlas
# (Connect → Drivers → older driver / standard connection string).
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/propertygpt?retryWrites=true&w=majority&appName=Cluster0"

# NextAuth
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_URL="https://your-production-domain.com"

# UploadThing (required for property image/document uploads on Vercel)
# Create an app at https://uploadthing.com/dashboard and paste the API token.
UPLOADTHING_TOKEN=""
# Legacy names (optional; v7 prefers UPLOADTHING_TOKEN):
# UPLOADTHING_SECRET=""
# UPLOADTHING_APP_ID=""

# Resend (required for signup OTP; agent activation also uses this)
# Domain must be verified in Resend before production sends.
RESEND_API_KEY=""
EMAIL_FROM="Manzil <noreply@yourdomain.com>"
# Optional OTP lifetime in minutes (default 10)
# OTP_EXPIRY_MINUTES="10"

# Messaging (hybrid AES body encryption)
# Live inbox updates use HTTP polling (Vercel-friendly). No WS host required.
# Prefer a dedicated 32+ char secret for MESSAGE_ENCRYPTION_KEY in production.
MESSAGE_ENCRYPTION_KEY=""
# Optional Socket.IO companion (not used on Vercel; leave unset):
# MESSAGING_WS_PORT="3001"
# MESSAGING_WS_SECRET=""
# MESSAGING_WS_INTERNAL_URL=""
# NEXT_PUBLIC_MESSAGING_WS_URL=""
